# Variable definitions
POSTGRES_PATH=./docker/postgres
SPARK_PATH=./docker/spark
AIRFLOW_PATH=./docker/airflow
DASHBOARD_PATH=./docker/dashboard

# Load environment variables
-include .env.development
export

.PHONY: help init build-all build-spark build-airflow build-dashboard \
        up down restart logs status clean \
        postgres-up postgres-down postgres-logs \
        spark-up spark-down spark-logs spark-status \
        airflow-up airflow-down airflow-logs airflow-status \
        dashboard-up dashboard-down dashboard-logs

# ============ HELP ============
help:
	@echo "Book Recommendation System - Fully Separated Docker Services"
	@echo ""
	@echo "Setup Commands:"
	@echo "  make init              - Full initialization (build + up all)"
	@echo "  make build-all         - Build all Docker images"
	@echo ""
	@echo "Service Commands:"
	@echo "  make up                - Start all services"
	@echo "  make down              - Stop all services"
	@echo "  make restart           - Restart all services"
	@echo ""
	@echo "Individual Services:"
	@echo "  make postgres-up       - Start PostgreSQL"
	@echo "  make spark-up          - Start Spark cluster"
	@echo "  make airflow-up        - Start Airflow"
	@echo "  make dashboard-up      - Start Streamlit dashboard"
	@echo ""
	@echo "Logs & Status:"
	@echo "  make logs              - Show logs from all services"
	@echo "  make status            - Show status of all services"
	@echo "  make postgres-logs     - Show PostgreSQL logs"
	@echo "  make spark-logs        - Show Spark logs"
	@echo "  make airflow-logs      - Show Airflow logs"
	@echo "  make dashboard-logs    - Show Dashboard logs"
	@echo ""
	@echo "Cleanup:"
	@echo "  make clean             - Stop and remove all containers + volumes"

# ============ BUILD COMMANDS ============
build-spark:
	@echo "Building Spark image..."
	DOCKER_BUILDKIT=0 docker compose -f $(SPARK_PATH)/docker-compose.yml build
	@echo "✓ Spark image built"

build-airflow:
	@echo "Building Airflow image..."
	docker compose -f $(AIRFLOW_PATH)/docker-compose.yml build
	@echo "✓ Airflow image built"

build-dashboard:
	@echo "Building Dashboard image..."
	docker compose -f $(DASHBOARD_PATH)/docker-compose.yml build
	@echo "✓ Dashboard image built"

build-all: build-spark build-airflow build-dashboard
	@echo "✓ All images built successfully"

# ============ POSTGRES COMMANDS ============
postgres-up:
	@echo "Starting PostgreSQL..."
	docker compose --env-file .env.development -f $(POSTGRES_PATH)/docker-compose.yml up -d
	@echo "Waiting for PostgreSQL to be healthy..."
	@timeout 60 sh -c 'until docker exec book-recs-postgres pg_isready -U $(DB_USER) -p 5433; do sleep 2; done' || echo "Timeout waiting for PostgreSQL"
	@echo "✓ PostgreSQL is ready"
	@echo "   Connection: localhost:5060 (maps to container port 5433)"

postgres-down:
	@echo "Stopping PostgreSQL..."
	docker compose -f $(POSTGRES_PATH)/docker-compose.yml down
	@echo "✓ PostgreSQL stopped"

postgres-logs:
	docker compose -f $(POSTGRES_PATH)/docker-compose.yml logs -f

# ============ SPARK COMMANDS ============
spark-up: build-spark
	@echo "Starting Spark cluster..."
	docker compose --env-file .env.development -f $(SPARK_PATH)/docker-compose.yml up -d
	@echo "Waiting for Spark Master..."
	@sleep 10
	@echo "✓ Spark cluster started"

spark-down:
	@echo "Stopping Spark cluster..."
	docker compose -f $(SPARK_PATH)/docker-compose.yml down
	@echo "✓ Spark cluster stopped"

spark-logs:
	docker compose -f $(SPARK_PATH)/docker-compose.yml logs -f

spark-status:
	docker compose -f $(SPARK_PATH)/docker-compose.yml ps

# ============ AIRFLOW COMMANDS ============
airflow-up: build-airflow postgres-up
	@echo "Starting Airflow..."
	docker compose --env-file .env.development -f $(AIRFLOW_PATH)/docker-compose.yml up -d
	@echo "Waiting for Airflow to initialize..."
	@sleep 20
	@echo "✓ Airflow started"
	@echo "   Airflow UI: http://localhost:$(AIRFLOW_PORT)"
	@echo "   Default login: admin / admin"

airflow-down:
	@echo "Stopping Airflow..."
	docker compose -f $(AIRFLOW_PATH)/docker-compose.yml down
	@echo "✓ Airflow stopped"

airflow-logs:
	docker compose -f $(AIRFLOW_PATH)/docker-compose.yml logs -f

airflow-status:
	docker compose -f $(AIRFLOW_PATH)/docker-compose.yml ps

# ============ DASHBOARD COMMANDS ============
dashboard-up: build-dashboard
	@echo "Starting Streamlit dashboard..."
	docker compose --env-file .env.development -f $(DASHBOARD_PATH)/docker-compose.yml up -d
	@echo "✓ Dashboard started"
	@echo "   Dashboard UI: http://localhost:$(DASHBOARD_PORT)"

dashboard-down:
	@echo "Stopping dashboard..."
	docker compose -f $(DASHBOARD_PATH)/docker-compose.yml down
	@echo "✓ Dashboard stopped"

dashboard-logs:
	docker compose -f $(DASHBOARD_PATH)/docker-compose.yml logs -f

load-data: postgres-up
	@echo ""
	@echo "================================================"
	@echo " LOADING KAGGLE DATA INTO DATABASE"
	@echo "================================================"
	@echo ""
	@echo " This will:"
	@echo "   1. Create database schema"
	@echo "   2. Load ~270K books from Kaggle"
	@echo "   3. Load ~278K users"
	@echo "   4. Load ~1M ratings"
	@echo "   5. Mark all books as unenriched"
	@echo ""
	@read -p "Press Enter to continue or Ctrl+C to cancel..."
	@python3 ingestion/first_load.py
	@echo ""
	@echo " Data loading complete!"
	@echo ""

# ============ COMBINED COMMANDS ============
up: postgres-up airflow-up dashboard-up
	@echo ""
	@echo "================================================"
	@echo "✓ All services started successfully!"
	@echo "================================================"
	@echo "Access points:"
	@echo "  - PostgreSQL:  localhost:5060 (internal: 5433)"
	@echo "  - Airflow UI:  http://localhost:$(AIRFLOW_PORT) (admin/admin)"
	@echo "  - Dashboard:   http://localhost:$(DASHBOARD_PORT)"
	@echo "================================================"
	@echo ""
	@echo "NOTE: Spark runs in LOCAL mode inside Airflow container"
	@echo "      (No separate Spark cluster needed)"
	@echo ""

# Optional: Add command to start WITH Spark cluster (for future scaling)
up-with-spark: postgres-up spark-up airflow-up dashboard-up
	@echo "✓ All services started (including Spark cluster)"

down: dashboard-down airflow-down spark-down postgres-down
	@echo "✓ All services stopped"

restart: down up

# ============ LOGS & STATUS ============
logs:
	@echo "\n=== PostgreSQL Logs ==="
	@docker compose -f $(POSTGRES_PATH)/docker-compose.yml logs --tail=20 2>/dev/null || echo "PostgreSQL not running"
	@echo "\n=== Spark Logs ==="
	@docker compose -f $(SPARK_PATH)/docker-compose.yml logs --tail=20 2>/dev/null || echo "Spark not running"
	@echo "\n=== Airflow Logs ==="
	@docker compose -f $(AIRFLOW_PATH)/docker-compose.yml logs --tail=20 2>/dev/null || echo "Airflow not running"
	@echo "\n=== Dashboard Logs ==="
	@docker compose -f $(DASHBOARD_PATH)/docker-compose.yml logs --tail=20 2>/dev/null || echo "Dashboard not running"

status:
	@echo "\n=== PostgreSQL Status ==="
	@docker compose -f $(POSTGRES_PATH)/docker-compose.yml ps 2>/dev/null || echo "PostgreSQL not running"
	@echo "\n=== Spark Status ==="
	@docker compose -f $(SPARK_PATH)/docker-compose.yml ps 2>/dev/null || echo "Spark not running"
	@echo "\n=== Airflow Status ==="
	@docker compose -f $(AIRFLOW_PATH)/docker-compose.yml ps 2>/dev/null || echo "Airflow not running"
	@echo "\n=== Dashboard Status ==="
	@docker compose -f $(DASHBOARD_PATH)/docker-compose.yml ps 2>/dev/null || echo "Dashboard not running"

init: build-all up
	@echo ""
	@echo "================================================"
	@echo " INITIALIZING DATABASE WITH KAGGLE DATA"
	@echo "================================================"
	@echo "  Resetting database schema..."
	@docker exec -i book-recs-postgres psql -U $(DB_USER) -d $(DB_NAME) -p 5433 -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public;"
	@echo " Database schema reset complete"
	@echo " Loading initial data (books, users, ratings)..."
	
	# Run Python script INSIDE the dashboard container (which has network access)
	@docker exec dashboard python /app/ingestion/first_load.py
	
	@echo " Initial data load complete!"
	@echo ""
	@echo "================================================"
	@echo "✓ FULL SYSTEM INIT COMPLETE!"
	@echo "Access points:"
	@echo "  - PostgreSQL:  localhost:5060 (internal: 5433)"
	@echo "  - Airflow UI:  http://localhost:$(AIRFLOW_PORT) (admin/admin)"
	@echo "  - Dashboard:   http://localhost:$(DASHBOARD_PORT)"
	@echo "================================================"

# ============ CLEANUP ============
clean: down
	@echo "Removing all volumes..."
	@docker compose -f $(POSTGRES_PATH)/docker-compose.yml down -v 2>/dev/null || true
	@docker compose -f $(SPARK_PATH)/docker-compose.yml down -v 2>/dev/null || true
	@docker compose -f $(AIRFLOW_PATH)/docker-compose.yml down -v 2>/dev/null || true
	@docker compose -f $(DASHBOARD_PATH)/docker-compose.yml down -v 2>/dev/null || true
	@echo "✓ Cleanup complete"