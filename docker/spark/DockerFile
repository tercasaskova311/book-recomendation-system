FROM bitnamilegacy/spark:3.5.6

USER root

# Install build dependencies for C extensions
RUN apt-get update && \
    apt-get install -y gcc python3-dev build-essential libffi-dev libssl-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY docker/spark/requirements.txt /tmp/requirements.txt

# Install Python packages from wheels / PyPI
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt

# Set environment
ENV PYSPARK_PYTHON=python3
ENV PYSPARK_DRIVER_PYTHON=python3
ENV PYTHONPATH=/opt/project:$PYTHONPATH

USER spark
WORKDIR /opt/project
