# Alternative: Use official Apache Spark base
FROM apache/spark:3.5.0-python3

USER root

# Install additional dependencies
RUN apt-get update && \
    apt-get install -y gcc python3-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY docker/spark/requirements.txt /tmp/requirements.txt

# Install Python dependencies
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt

# Create project directories
RUN mkdir -p /opt/project /opt/project/delta /opt/project/spark /opt/project/common && \
    chown -R spark:spark /opt/project

# Set environment
ENV PYSPARK_PYTHON=python3
ENV PYSPARK_DRIVER_PYTHON=python3
ENV PYTHONPATH=/opt/project:$PYTHONPATH

USER spark

WORKDIR /opt/spark