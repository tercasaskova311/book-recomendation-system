FROM apache/airflow:2.9.0-python3.11

USER root

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openjdk-17-jdk \
        curl \
        procps && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Spark 3.5.0
RUN curl -fsSL https://archive.apache.org/dist/spark/spark-3.5.0/spark-3.5.0-bin-hadoop3.tgz \
    | tar -xz -C /opt/ && \
    ln -s /opt/spark-3.5.0-bin-hadoop3 /opt/spark

# In docker/airflow/Dockerfile, add after Spark installation:
RUN curl -o /opt/spark/jars/postgresql-42.7.1.jar \
    https://jdbc.postgresql.org/download/postgresql-42.7.1.jar
    
# Set environment variables
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV SPARK_HOME=/opt/spark
ENV PATH="${PATH}:${SPARK_HOME}/bin:/home/airflow/.local/bin"
ENV PYSPARK_PYTHON=python3
ENV PYTHONPATH="/opt/airflow:/opt/airflow/dags:/opt/project:${PYTHONPATH}"

# Create config directory with correct permissions
RUN mkdir -p /opt/airflow/config \
             /opt/airflow/dags \
             /opt/airflow/plugins \
             /opt/airflow/logs \
             /opt/project && \
    chown -R airflow:root /opt/airflow /opt/project

# Switch to airflow user
USER airflow

# Copy and install requirements
COPY docker/airflow/requirements.txt /requirements.txt
RUN pip install --no-cache-dir -r /requirements.txt

WORKDIR /opt/airflow